# ============================================================
# AICP Engine 配置文件模板
# 复制此文件为 aicp.yaml，填入你自己的配置
# aicp.yaml 不要提交到仓库（已在 .gitignore 中）
# ============================================================

# ---------- 基础服务 ----------
host: 0.0.0.0
port: 9000
static_dir: www
data_dir: data
plugins_dir: plugins

# ---------- WebSocket ----------
websocket:
  external_url: ws://127.0.0.1:9001/ws

upload:
  external_url: http://127.0.0.1:9002/upload

# ---------- 认证 ----------
enable_auth: false

# 你的 允许访问 token 列表（至少一个主token）
tokens:
  - 你的token

# Studio token（可选）
studio_token: 你的token

# 主会话 ID（webhook、回调、定时任务都会唤醒这个 session）
session_id: 你的session_id=你的访问主token



# ---------- 模型配置 ----------
models:
  roles:
    default: 你的默认模型
    coding: 你的编码模型
    reasoning: 你的推理模型
  max_retries: 3
  request_timeout: 90
  stream_timeout: 300
  max_concurrent: 5
  providers:
    # 你的模型提供商配置
    openai:
      base_url: https://你的提供商地址/v1
      api_key: 你的API Key
      models:
        - id: 你的模型ID
          max_tokens: 32768
          temperature: 0.1

# ---------- Gitee 自举管理（可选）----------
gitee:
  access_token: 你的Gitee私人令牌
  owner: 你的Gitee用户名
  repo: 你的仓库名
  branch: main
  webhook_secret: 你的webhook密码
  session_id: 你的session_id=你的访问主token
